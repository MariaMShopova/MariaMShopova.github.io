---
import { siteConfig } from "../config";
const hasGlobalLeadership = siteConfig.globalLeadership && siteConfig.globalLeadership.length > 0;
---

{
  hasGlobalLeadership && (
    <section id="global-leadership" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Global Leadership & Advisory
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <ul class="space-y-6">
              {siteConfig.globalLeadership.map((item) => (
                <li class="flex items-start">
                  <span
                    class="inline-block w-1.5 h-1.5 rounded-full mt-2.5 mr-4 flex-shrink-0"
                    style={`background-color: ${siteConfig.accentColor}`}
                  />
                  <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                    <span class="font-semibold text-gray-900">{item.org}</span>
                    <span class="text-gray-500"> — {item.location}</span>
                    {": "}
                    {item.description}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
