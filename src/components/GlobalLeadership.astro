---
import { siteConfig } from "../config";
const hasGlobalLeadership = siteConfig.globalLeadership && siteConfig.globalLeadership.length > 0;
---

{
  hasGlobalLeadership && (
    <section id="global-leadership" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Global Leadership & Advisory
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.globalLeadership.map((item) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <p
                    class="text-base sm:text-lg mb-4"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {item.org}
                    <span class="text-gray-500 text-sm sm:text-base"> · {item.location}</span>
                  </p>
                  <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
