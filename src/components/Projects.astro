---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

// Status colours carry meaning at a glance: green = live, yellow = still in
// development. Any other status falls back to the site's accent colour.
const statusPalette: Record<string, { color: string; bg: string; border: string; dot: string }> = {
  live: { color: "#166534", bg: "#dcfce7", border: "#86efac", dot: "#16a34a" },
  "in development": { color: "#854d0e", bg: "#fef9c3", border: "#fde047", dot: "#eab308" },
};
const statusStyle = (status: string) => {
  const p = statusPalette[status.trim().toLowerCase()];
  return p ?? { color: siteConfig.accentColor, bg: `${siteConfig.accentColor}10`, border: `${siteConfig.accentColor}55`, dot: siteConfig.accentColor };
};

// A highlight written as "Short lead - the detail" shows its lead in bold so
// the list can be skimmed; anything without that shape renders as plain text.
const splitHighlight = (text: string) => {
  const i = text.indexOf(" - ");
  return i > 0 && i <= 70 ? { lead: text.slice(0, i), rest: text.slice(i + 3) } : { lead: null, rest: text };
};
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                        project.link
                          ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                          : ""
                      }`}
                    >
                      {project.link && (
                        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <div class="flex items-center gap-3">
                            <span
                              class="text-sm font-mono"
                              style={{ color: siteConfig.accentColor }}
                            >
                              0{index + 1}
                            </span>
                            {project.status && (
                              <span
                                class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold border"
                                style={`color: ${statusStyle(project.status).color}; border-color: ${statusStyle(project.status).border}; background-color: ${statusStyle(project.status).bg}`}
                              >
                                <span
                                  class="inline-block w-1.5 h-1.5 rounded-full"
                                  style={`background-color: ${statusStyle(project.status).dot}`}
                                />
                                {project.status}
                              </span>
                            )}
                          </div>
                          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
                            {project.name}
                          </h3>
                        </div>

                        <p
                          class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {project.highlights && project.highlights.length > 0 && (
                          <ul class="space-y-2">
                            {project.highlights.map((highlight) => (
                              <li class="flex items-start">
                                <span
                                  class="inline-block w-1.5 h-1.5 rounded-full mt-2.5 mr-3 flex-shrink-0"
                                  style={`background-color: ${siteConfig.accentColor}`}
                                />
                                <span class="text-sm sm:text-base text-gray-600 leading-relaxed">
                                  {splitHighlight(highlight).lead ? (
                                    <Fragment>
                                      <strong class="font-semibold text-gray-900">{splitHighlight(highlight).lead}</strong>
                                      {" - "}
                                      {splitHighlight(highlight).rest}
                                    </Fragment>
                                  ) : (
                                    highlight
                                  )}
                                </span>
                              </li>
                            ))}
                          </ul>
                        )}

                        {project.link && project.linkLabel && (
                          <div>
                            <span
                              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm sm:text-base font-bold text-white shadow-sm transition-all duration-300 group-hover:gap-3 group-hover:shadow-lg"
                              style={`background-color: ${siteConfig.accentColor}`}
                            >
                              {project.linkLabel}
                              <span aria-hidden="true">→</span>
                            </span>
                          </div>
                        )}

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.link ? "group-hover:bg-gray-800" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
